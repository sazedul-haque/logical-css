{
  "name": "logical-css",
  "displayName": "Logical CSS",
  "description": "Help developers write RTL-friendly and CSS Logical Property–aware styles by analyzing CSS/SCSS and providing diagnostics, quick fixes, and optional auto-fixes.",
  "version": "1.0.0",
  "publisher": "logical-css",
  "author": "Sazedul Haque",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sazedul-haque/logical-css"
  },
  "bugs": {
    "url": "https://github.com/sazedul-haque/logical-css/issues"
  },
  "homepage": "https://github.com/sazedul-haque/logical-css#readme",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "css",
    "rtl",
    "logical-properties",
    "i18n",
    "localization",
    "scss",
    "style",
    "diagnostics"
  ],
  "activationEvents": [
    "onLanguage:css",
    "onLanguage:scss",
    "onLanguage:less",
    "onLanguage:vue",
    "onLanguage:svelte",
    "onLanguage:html",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Logical CSS",
      "properties": {
        "logicalCss.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable Logical CSS diagnostics"
        },
        "logicalCss.enableQuickFix": {
          "type": "boolean",
          "default": true,
          "description": "Enable quick fix code actions"
        },
        "logicalCss.severity": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "info",
            "hint"
          ],
          "default": "warning",
          "description": "Severity level for diagnostics"
        },
        "logicalCss.ignoreProperties": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "List of CSS properties to ignore"
        },
        "logicalCss.ignoreValues": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "List of CSS values to ignore"
        },
        "logicalCss.enableHover": {
          "type": "boolean",
          "default": true,
          "description": "Enable hover information for physical properties"
        },
        "logicalCss.enableStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Enable status bar item"
        },
        "logicalCss.autoFixOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Auto-fix issues on save"
        }
      }
    },
    "commands": [
      {
        "command": "logicalCss.scanWorkspace",
        "title": "Logical CSS: Scan Workspace"
      },
      {
        "command": "logicalCss.scanCurrentFile",
        "title": "Logical CSS: Scan Current File"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "node esbuild.config.js --production",
    "watch": "node esbuild.config.js --watch",
    "pretest": "tsc --noEmit && pnpm run compile && pnpm run lint",
    "lint": "eslint src --ext ts",
    "lint:fix": "eslint src --ext ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage",
    "package": "npx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitest/coverage-v8": "^1.0.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^8.54.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "postcss": "^8.4.32",
    "postcss-safe-parser": "^7.0.0"
  }
}
